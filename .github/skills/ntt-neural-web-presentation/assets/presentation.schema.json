{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ntt-neural-presentation.schema.json",
  "title": "NTT Neural Web Presentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "overviewCamera", "keywords", "nodes", "slides"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string" },
        "subtitle": { "type": "string" },
        "language": { "type": "string", "minLength": 2 },
        "theme": { "type": "string", "default": "ntt-neural" }
      }
    },
    "overviewCamera": { "$ref": "#/$defs/camera" },
    "keywords": {
      "type": "array",
      "minItems": 3,
      "maxItems": 24,
      "items": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "target", "fov"],
      "properties": {
        "position": { "$ref": "#/$defs/vector3" },
        "target": { "$ref": "#/$defs/vector3" },
        "fov": { "type": "number", "minimum": 20, "maximum": 90 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "position": { "$ref": "#/$defs/vector3" },
        "cameraOffset": { "$ref": "#/$defs/vector3" },
        "lookAtOffset": { "$ref": "#/$defs/vector3" },
        "fov": { "type": "number", "minimum": 20, "maximum": 90 },
        "weight": { "type": "number", "minimum": 0.5, "maximum": 3 }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "nodeId", "order", "layout", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "nodeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "order": { "type": "integer", "minimum": 1 },
        "layout": {
          "type": "string",
          "enum": ["statement", "split", "process", "data", "comparison", "case-study", "closing"]
        },
        "kicker": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "lead": { "type": "string" },
        "body": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "metrics": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/metric" }
        },
        "notes": { "type": "string" }
      }
    }
  }
}
